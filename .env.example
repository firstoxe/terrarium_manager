SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Required when DEBUG=False (shared cache for ratelimit + select2 across workers)
USE_REDIS=False
REDIS_URL=redis://127.0.0.1:6379
REDIS_SELECT2_URL=redis://127.0.0.1:6379/2

# console in DEBUG; smtp when DEBUG=False (override if needed)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Terrarium Manager <noreply@localhost>

# Comma-separated: email or "Name <email@example.com>"
# ADMINS=

# Production database (optional)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=terrarium_manager
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Celery (optional)
# CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# Telegram reminders (optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# Sentry (optional)
# SENTRY_DSN=

# Behind HTTPS reverse proxy (production)
# BEHIND_TLS_PROXY=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
